{% comment %}
  Section: Reviews Trustpilot Bar
  A full-width Trustpilot-style review section with optional auto-sliding cards.
  Compatible with Maestrooo Stretch Theme (Online Store 2.0).
{% endcomment %}

{%- liquid
  assign trust_score = section.settings.trust_score
  assign review_count_label = section.settings.review_count_label
  assign autoplay_enabled = section.settings.autoplay_enabled
  assign autoplay_speed = section.settings.autoplay_speed
  assign pause_on_hover = section.settings.pause_on_hover
  assign padding_top = section.settings.padding_top
  assign padding_bottom = section.settings.padding_bottom
  assign review_blocks = section.blocks | where: "type", "review"
  assign block_count = review_blocks | size
  assign needs_slider = false
  if block_count > 4
    assign needs_slider = true
  endif
-%}

<style>
  /* ===== Scoped styles for reviews-trustpilot ===== */
  .rtp-section-{{ section.id }} {
    background-color: {{ section.settings.background_color | default: '#576533' }};
    padding-top: {{ padding_top }}px;
    padding-bottom: {{ padding_bottom }}px;
    overflow: hidden;
  }

  .rtp-section-{{ section.id }} .rtp-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  /* --- Left info block --- */
  .rtp-section-{{ section.id }} .rtp-info {
    flex: 0 0 220px;
    min-width: 200px;
    color: #d2c99e;
  }

  .rtp-section-{{ section.id }} .rtp-info__title {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0 0 2px;
    color: #d2c99e;
  }

  .rtp-section-{{ section.id }} .rtp-info__subtitle {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 24px;
    color: #d2c99e;
  }

  .rtp-section-{{ section.id }} .rtp-info__count {
    font-size: 13px;
    font-weight: 400;
    margin: 0 0 6px;
    color: #d2c99e;
    opacity: 0.85;
  }

  .rtp-section-{{ section.id }} .rtp-stars {
    display: inline-flex;
    gap: 3px;
  }

  .rtp-section-{{ section.id }} .rtp-stars svg {
    width: 28px;
    height: 28px;
  }

  .rtp-section-{{ section.id }} .rtp-stars--small svg {
    width: 18px;
    height: 18px;
  }

  .rtp-section-{{ section.id }} .rtp-star--filled {
    fill: #00b67a;
  }

  .rtp-section-{{ section.id }} .rtp-star--empty {
    fill: none;
    stroke: #00b67a;
    stroke-width: 1.5;
  }

  /* --- Slider / cards area --- */
  .rtp-section-{{ section.id }} .rtp-slider-wrap {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    position: relative;
  }

  .rtp-section-{{ section.id }} .rtp-track {
    display: flex;
    gap: 20px;
    will-change: transform;
  }

  .rtp-section-{{ section.id }} .rtp-track--animated {
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .rtp-section-{{ section.id }} .rtp-track--static {
    flex-wrap: nowrap;
  }

  /* --- Card: 4 visible on desktop --- */
  .rtp-section-{{ section.id }} .rtp-card {
    flex: 0 0 calc((100% - 60px) / 4);
    background-color: #465228;
    border-radius: 10px;
    padding: 24px 24px 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 180px;
    color: #d2c99e;
    box-sizing: border-box;
  }

  .rtp-section-{{ section.id }} .rtp-card__name {
    font-size: 15px;
    font-weight: 700;
    margin: 0 0 8px;
    color: #d2c99e;
  }

  .rtp-section-{{ section.id }} .rtp-card__text {
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0 0 auto;
    color: #d2c99e;
    opacity: 0.9;
  }

  .rtp-section-{{ section.id }} .rtp-card__location {
    font-size: 12px;
    color: #d2c99e;
    opacity: 0.65;
    margin-top: 4px;
  }

  .rtp-section-{{ section.id }} .rtp-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 16px;
  }

  .rtp-section-{{ section.id }} .rtp-card__date {
    font-size: 12px;
    color: #d2c99e;
    opacity: 0.7;
  }

  /* --- Responsive --- */
  @media (max-width: 999px) {
    .rtp-section-{{ section.id }} .rtp-card {
      flex: 0 0 calc((100% - 20px) / 2);
    }
  }

  @media (max-width: 749px) {
    .rtp-section-{{ section.id }} .rtp-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 28px;
    }

    .rtp-section-{{ section.id }} .rtp-info {
      flex: none;
      width: 100%;
      text-align: center;
    }

    .rtp-section-{{ section.id }} .rtp-info__stars-row {
      justify-content: center;
    }

    .rtp-section-{{ section.id }} .rtp-slider-wrap {
      width: 100%;
    }

    .rtp-section-{{ section.id }} .rtp-card {
      flex: 0 0 100%;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .rtp-section-{{ section.id }} .rtp-track--animated {
      transition: none;
    }
  }
</style>

<section
  class="rtp-section-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="reviews-trustpilot"
  aria-label="Customer reviews"
>
  <div class="rtp-container">
    {%- comment -%} Left info block {%- endcomment -%}
    <div class="rtp-info">
      <p class="rtp-info__title">{{ section.settings.heading | default: 'Fremragende' }}</p>
      <p class="rtp-info__subtitle">{{ trust_score | default: '4,7' }} på Trustpilot</p>
      <p class="rtp-info__count">{{ review_count_label | default: 'Baseret på +30 anmeldelser' }}</p>
      <div class="rtp-stars rtp-info__stars-row" aria-label="Rating: {{ trust_score | default: '4,7' }} out of 5 stars">
        {%- for i in (1..5) -%}
          <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M12 1.5L15.09 7.74L22 8.63L17 13.47L18.18 20.34L12 17.09L5.82 20.34L7 13.47L2 8.63L8.91 7.74L12 1.5Z" class="rtp-star--filled"/>
          </svg>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} Right slider / cards {%- endcomment -%}
    <div
      class="rtp-slider-wrap"
      id="rtp-slider-{{ section.id }}"
      data-autoplay="{{ autoplay_enabled }}"
      data-speed="{{ autoplay_speed }}"
      data-pause-hover="{{ pause_on_hover }}"
      data-count="{{ block_count }}"
      role="region"
      aria-roledescription="carousel"
      aria-label="Customer review cards"
    >
      <div class="rtp-track {% if needs_slider %}rtp-track--animated{% else %}rtp-track--static{% endif %}" id="rtp-track-{{ section.id }}">
        {%- for block in review_blocks -%}
          {%- assign star_count = block.settings.stars | default: 5 -%}
          <div class="rtp-card" {{ block.shopify_attributes }} role="group" aria-roledescription="slide" aria-label="Review {{ forloop.index }} of {{ block_count }}">
            <div>
              <p class="rtp-card__name">{{ block.settings.name }}</p>
              <p class="rtp-card__text">{{ block.settings.review_text }}</p>
              {%- if block.settings.location != blank -%}
                <p class="rtp-card__location">{{ block.settings.location }}</p>
              {%- endif -%}
            </div>
            <div class="rtp-card__footer">
              <div class="rtp-stars rtp-stars--small" aria-label="{{ star_count }} out of 5 stars">
                {%- for s in (1..5) -%}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    {%- if s <= star_count -%}
                      <path d="M12 1.5L15.09 7.74L22 8.63L17 13.47L18.18 20.34L12 17.09L5.82 20.34L7 13.47L2 8.63L8.91 7.74L12 1.5Z" class="rtp-star--filled"/>
                    {%- else -%}
                      <path d="M12 1.5L15.09 7.74L22 8.63L17 13.47L18.18 20.34L12 17.09L5.82 20.34L7 13.47L2 8.63L8.91 7.74L12 1.5Z" class="rtp-star--empty"/>
                    {%- endif -%}
                  </svg>
                {%- endfor -%}
              </div>
              <span class="rtp-card__date">{{ block.settings.date }}</span>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var SECTION_ID = '{{ section.id }}';
    var wrap = document.getElementById('rtp-slider-' + SECTION_ID);
    if (!wrap) return;

    var track = document.getElementById('rtp-track-' + SECTION_ID);
    var count = parseInt(wrap.dataset.count, 10) || 0;
    var autoplayEnabled = wrap.dataset.autoplay === 'true';
    var speed = parseInt(wrap.dataset.speed, 10) || 3500;
    var pauseOnHover = wrap.dataset.pauseHover === 'true';

    /* Determine visible count based on viewport */
    function getVisible() {
      var w = window.innerWidth;
      if (w <= 749) return 1;
      if (w <= 999) return 2;
      return 4;
    }

    /* Only activate slider if cards exceed visible count */
    function shouldSlide() {
      return count > getVisible();
    }

    if (!shouldSlide() && count <= 4) {
      /* Static layout — no JS slider needed */
      track.classList.remove('rtp-track--animated');
      track.classList.add('rtp-track--static');
      return;
    }

    /* Respect prefers-reduced-motion */
    var prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (prefersReducedMotion.matches) {
      autoplayEnabled = false;
    }
    prefersReducedMotion.addEventListener('change', function (e) {
      if (e.matches) {
        stopAutoplay();
        autoplayEnabled = false;
      }
    });

    /* Clone cards for infinite loop */
    var cards = track.querySelectorAll('.rtp-card');
    var gap = 20;

    /* Clone all cards and append / prepend for seamless loop */
    cards.forEach(function (card) {
      var cloneAfter = card.cloneNode(true);
      cloneAfter.setAttribute('aria-hidden', 'true');
      cloneAfter.removeAttribute('id');
      track.appendChild(cloneAfter);
    });

    cards.forEach(function (card) {
      var cloneBefore = card.cloneNode(true);
      cloneBefore.setAttribute('aria-hidden', 'true');
      cloneBefore.removeAttribute('id');
      track.insertBefore(cloneBefore, track.firstChild);
    });

    var allCards = track.querySelectorAll('.rtp-card');
    var currentIndex = count; /* Start at first real card */
    var autoplayTimer = null;
    var isTransitioning = false;

    function getCardWidth() {
      return allCards[0].offsetWidth + gap;
    }

    function jumpTo(index, animate) {
      var cardW = getCardWidth();
      if (!animate) {
        track.classList.remove('rtp-track--animated');
      } else {
        track.classList.add('rtp-track--animated');
      }
      track.style.transform = 'translateX(' + -(index * cardW) + 'px)';
    }

    function goNext() {
      if (isTransitioning) return;
      isTransitioning = true;
      currentIndex++;
      jumpTo(currentIndex, true);
    }

    /* After transition ends, silently reset if we've scrolled into clones */
    track.addEventListener('transitionend', function () {
      isTransitioning = false;
      if (currentIndex >= count * 2) {
        currentIndex = count;
        jumpTo(currentIndex, false);
      } else if (currentIndex < count) {
        currentIndex = count + (currentIndex % count);
        jumpTo(currentIndex, false);
      }
      /* Force reflow so next animated transition works */
      void track.offsetHeight;
    });

    /* Initial position (no animation) */
    jumpTo(currentIndex, false);

    /* Autoplay */
    function startAutoplay() {
      if (!autoplayEnabled) return;
      stopAutoplay();
      autoplayTimer = setInterval(goNext, speed);
    }

    function stopAutoplay() {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    if (pauseOnHover) {
      wrap.addEventListener('mouseenter', stopAutoplay);
      wrap.addEventListener('mouseleave', startAutoplay);
      wrap.addEventListener('focusin', stopAutoplay);
      wrap.addEventListener('focusout', startAutoplay);
    }

    startAutoplay();

    /* Recalculate on resize */
    var resizeTimeout;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function () {
        jumpTo(currentIndex, false);
      }, 200);
    });

    /* Cleanup on section unload (Shopify theme editor) */
    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail.sectionId === SECTION_ID) {
        stopAutoplay();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Reviews – Trustpilot",
  "tag": "section",
  "class": "rtp-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fremragende"
    },
    {
      "type": "text",
      "id": "trust_score",
      "label": "Trust score",
      "default": "4,7"
    },
    {
      "type": "text",
      "id": "review_count_label",
      "label": "Review count label",
      "default": "Baseret på +30 anmeldelser"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#576533"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "autoplay_enabled",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed (ms)",
      "min": 2000,
      "max": 8000,
      "step": 500,
      "default": 3500,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Reviewer name",
          "default": "Lene Nielsen"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review text",
          "default": "Mega hurtig levering og indpakning var super fint. Absolut super sted jeg kan anbefale. Mvh"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "31. okt. 2025"
        },
        {
          "type": "range",
          "id": "stars",
          "label": "Star rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location (optional)"
        }
      ]
    }
  ],
