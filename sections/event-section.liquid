{%- comment -%}
  ============================================================================
  Section: Event
  Theme:   Stretch by Maestrooo
  ----------------------------------------------------------------------------
  A reusable section for blog post / article templates that displays event
  metadata (date, time, location) with optional "Add to Calendar" and
  Facebook event action buttons.
  
  Follows Stretch conventions:
    – `container` class toggled via "Add horizontal spacing" checkbox
    – `section-spacing` for vertical rhythm
    – `color-scheme--{{ id }}` for palette integration
    – `section-stack` for internal vertical stacking
  ============================================================================
{%- endcomment -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="{% if section.settings.add_horizontal_spacing %}container{% endif %} section-spacing">
    <div class="section-stack">

      {%- comment -%} ── Heading ─────────────────────────────────────── {%- endcomment -%}
      {%- if section.settings.heading != blank -%}
        <div class="section-header">
          <h2 class="{{ section.settings.heading_size }}">
            {{- section.settings.heading | escape -}}
          </h2>
        </div>
      {%- endif -%}

      {%- comment -%}
        ── Meta bar ─────────────────────────────────────────────────
        Shows event date/time, location, and action buttons in one
        row. Only renders when at least one value is present.
      {%- endcomment -%}
      {%- liquid
        assign has_date     = false
        assign has_location = false
        assign has_actions  = false

        if section.settings.event_date != blank
          assign has_date = true
        endif

        if section.settings.event_location != blank
          assign has_location = true
        endif

        if section.settings.enable_add_to_calendar or section.settings.facebook_event_url != blank
          assign has_actions = true
        endif
      -%}

      {%- if has_date or has_location or has_actions -%}
        <div class="event-meta">

          {%- comment -%} ── Date & time ───────────────────────────── {%- endcomment -%}
          {%- if has_date -%}
            <span class="event-meta__item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              {%- comment -%} Reformat YYYY-MM-DD → DD-MM-YYYY (Danish) {%- endcomment -%}
              {%- assign date_parts = section.settings.event_date | split: '-' -%}
              <span>
                {%- if date_parts.size == 3 -%}{{ date_parts[2] }}-{{ date_parts[1] }}-{{ date_parts[0] }}{%- else -%}{{ section.settings.event_date }}{%- endif -%}
                {%- if section.settings.event_time != blank %} · {{ section.settings.event_time }}{%- endif -%}
                {%- if section.settings.event_end_time != blank %} – {{ section.settings.event_end_time }}{%- endif -%}
              </span>
            </span>
          {%- endif -%}

          {%- comment -%} ── Location ────────────────────────────────── {%- endcomment -%}
          {%- if has_location -%}
            <span class="event-meta__item">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{{ section.settings.event_location | escape }}</span>
            </span>
          {%- endif -%}

          {%- comment -%} ── Action buttons ──────────────────────────── {%- endcomment -%}
          {%- if has_actions -%}
            <span class="event-meta__actions">

              {%- if section.settings.enable_add_to_calendar -%}
                <button
                  type="button"
                  class="event-btn event-btn--primary"
                  data-add-to-calendar
                  data-event-title="{{ section.settings.heading | default: 'Event' | escape }}"
                  data-event-date="{{ section.settings.event_date | escape }}"
                  data-event-time="{{ section.settings.event_time | escape }}"
                  data-event-end-time="{{ section.settings.event_end_time | escape }}"
                  data-event-location="{{ section.settings.event_location | escape }}"
                  aria-label="Add to calendar"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="12" y1="14" x2="12" y2="18"/><line x1="10" y1="16" x2="14" y2="16"/></svg>
                  Tilføj til kalender
                </button>
              {%- endif -%}

              {%- if section.settings.facebook_event_url != blank -%}
                <a
                  href="{{ section.settings.facebook_event_url }}"
                  class="event-btn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="View Facebook event"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                  Facebook begivenhed
                </a>
              {%- endif -%}

            </span>
          {%- endif -%}

        </div>
      {%- endif -%}

      {%- comment -%}
        ── Optional description ─────────────────────────────────────
        Rich text field for a short event summary. Uses the theme's
        `rte` class for consistent rich-text typography.
      {%- endcomment -%}
      {%- if section.settings.event_description != blank -%}
        <div class="event-description rte">
          {{ section.settings.event_description }}
        </div>
      {%- endif -%}

    </div>{%- comment -%} .section-stack {%- endcomment -%}
  </div>{%- comment -%} .container .section-spacing {%- endcomment -%}
</div>{%- comment -%} .color-scheme {%- endcomment -%}

{%- comment -%} ── Scoped styles ────────────────────────────────────────── {%- endcomment -%}
<style>
  /* ── Meta bar ──────────────────────────────────────────────────── */
  .event-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--border-radius, 8px);
    background: rgba(var(--color-foreground-rgb, 0 0 0) / 0.04);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .event-meta__item {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .event-meta__item svg {
    flex-shrink: 0;
    opacity: 0.55;
  }

  /* ── Description ─────────────────────────────────────────────────── */
  .event-description {
    max-width: 72ch;
  }

  /* ── Action buttons ──────────────────────────────────────────────── */
  .event-meta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-left: auto;
  }

  .event-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    line-height: 1;
    text-decoration: none;
    border: 1px solid currentColor;
    border-radius: var(--button-border-radius, 4px);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
    color: rgb(var(--color-foreground-rgb, 26 26 26));
    background: transparent;
  }

  .event-btn:hover {
    background: rgb(var(--color-foreground-rgb, 26 26 26));
    color: rgb(var(--color-background-rgb, 255 255 255));
  }

  .event-btn svg {
    flex-shrink: 0;
  }

  .event-btn--primary {
    background: rgb(var(--color-foreground-rgb, 26 26 26));
    color: rgb(var(--color-background-rgb, 255 255 255));
    border-color: rgb(var(--color-foreground-rgb, 26 26 26));
  }

  .event-btn--primary:hover {
    opacity: 0.85;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media screen and (max-width: 699px) {
    .event-meta {
      flex-direction: column;
      align-items: flex-start;
    }
    .event-meta__actions {
      margin-left: 0;
      width: 100%;
    }
  }
</style>

{%- comment -%}
  ── "Add to Calendar" JavaScript ───────────────────────────────────
  Generates a .ics file client-side and triggers a download.
  Only included when the feature is enabled — zero JS otherwise.
{%- endcomment -%}
{%- if section.settings.enable_add_to_calendar -%}
<script>
  (function () {
    var section = document.querySelector('[data-section-id="{{ section.id }}"]') ||
                  document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var btn = section.querySelector('[data-add-to-calendar]');
    if (!btn) return;

    btn.addEventListener('click', function () {
      var title    = btn.dataset.eventTitle    || 'Event';
      var date     = btn.dataset.eventDate     || '';
      var time     = btn.dataset.eventTime     || '';
      var endTime  = btn.dataset.eventEndTime  || '';
      var location = btn.dataset.eventLocation || '';

      function parseDateTime(dateStr, timeStr) {
        if (!dateStr) return null;
        var d = new Date(dateStr + (timeStr ? 'T' + timeStr.replace(/\s/g, '') : ''));
        if (isNaN(d.getTime())) d = new Date(dateStr);
        if (isNaN(d.getTime())) return null;
        return d;
      }

      function toICS(d) {
        return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      }

      var start = parseDateTime(date, time);
      if (!start) {
        alert('Could not determine the event date.');
        return;
      }

      var end = parseDateTime(date, endTime);
      if (!end || end <= start) {
        end = new Date(start.getTime() + 2 * 60 * 60 * 1000);
      }

      var ics = [
        'BEGIN:VCALENDAR',
        'VERSION:2.0',
        'PRODID:-//Shopify Event Section//EN',
        'BEGIN:VEVENT',
        'DTSTART:' + toICS(start),
        'DTEND:' + toICS(end),
        'SUMMARY:' + title.replace(/,/g, '\\,'),
        'LOCATION:' + location.replace(/,/g, '\\,'),
        'END:VEVENT',
        'END:VCALENDAR'
      ].join('\r\n');

      var blob = new Blob([ics], { type: 'text/calendar;charset=utf-8' });
      var url  = URL.createObjectURL(blob);
      var a    = document.createElement('a');
      a.href     = url;
      a.download = title.replace(/\s+/g, '_') + '.ics';
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Event",
  "class": "shopify-section--event",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "add_horizontal_spacing",
      "label": "t:global.spacing.add_horizontal_spacing",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Upcoming Events"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h3", "label": "Small" },
        { "value": "h2", "label": "Medium" },
        { "value": "h1", "label": "Large" }
      ],
      "default": "h2"
    },
    {
      "type": "header",
      "content": "Event details"
    },
    {
      "type": "text",
      "id": "event_date",
      "label": "Event date",
      "info": "Enter as YYYY-MM-DD (e.g. 2026-06-15). Displayed as DD-MM-YYYY on the storefront."
    },
    {
      "type": "text",
      "id": "event_time",
      "label": "Start time",
      "info": "e.g. 18:00 or 6:00 PM"
    },
    {
      "type": "text",
      "id": "event_end_time",
      "label": "End time",
      "info": "e.g. 21:00 or 9:00 PM. Defaults to 2 hours after start."
    },
    {
      "type": "text",
      "id": "event_location",
      "label": "Location",
      "info": "Venue name and/or address."
    },
    {
      "type": "richtext",
      "id": "event_description",
      "label": "Description",
      "info": "Optional short summary shown below the meta bar."
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "checkbox",
      "id": "enable_add_to_calendar",
      "label": "Enable \"Add to Calendar\" button",
      "default": false,
      "info": "Generates a downloadable .ics file for the event."
    },
    {
      "type": "url",
      "id": "facebook_event_url",
      "label": "Facebook event link",
      "info": "Full URL of the Facebook event. Leave blank to hide."
    }
  ],
  "presets": [
    {
      "name": "Event",
      "category": "t:global.categories.custom"
    }
  ]
}
{% endschema %}
