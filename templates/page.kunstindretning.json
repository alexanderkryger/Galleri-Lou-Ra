pe":"subheading","settings":{"text":"<em>Trin 1<\/em>","position":"bottom_left"}},"heading_gX9cxH":{"type":"heading","settings":{"text":"1 time i galleriet","heading_tag":"h2","position":"bottom_left","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}},"richtext_mmD3JU":{"type":"richtext","settings":{"text":"<h5>Vi starter med et besøg i galleriet, hvor vi lærer jeres smag at kende. Sammen udvælger vi de værker, der passer til jeres hjem og det udtryk I ønsker.<\/h5>","position":"bottom_left"}}},"block_order":["subheading_c87F6Y","heading_gX9cxH","richtext_mmD3JU"],"disabled":true,"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-5","content_position":"start","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"add_media_spacing":true,"autoplay_video":true,"primary_image":"shopify:\/\/shop_images\/kunstindretning_billede_1.jpg","secondary_media_width":60,"secondary_media_mobile_width":60,"show_secondary_media_on_mobile":true,"secondary_media_alignment":"place-self-center","secondary_media_shape":"none"}},"text_with_media_MqXCa4":{"type":"text-with-media","blocks":{"subheading_4NxVUQ":{"type":"subheading","settings":{"text":"<em>Trin 2<\/em>","position":"top_right"}},"heading_MQkpeF":{"type":"heading","settings":{"text":"2 timer i jeres hjem","heading_tag":"h2","position":"top_right","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}},"richtext_wcpjeR":{"type":"richtext","settings":{"text":"<h5>Vi kommer hjem til jer med de udvalgte værker og afprøver dem i jeres rum. Vi tester placeringer, skaber balance og finder det rette udtryk til vægge, rum og lys.<\/h5>","position":"top_right"}}},"block_order":["subheading_4NxVUQ","heading_MQkpeF","richtext_wcpjeR"],"disabled":true,"name":"t:sections.text_with_media.name","settings":{"color_scheme":"scheme-5","content_position":"end","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"a