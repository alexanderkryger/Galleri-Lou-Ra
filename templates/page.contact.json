{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"color_scheme":"","show_title":true,"content_width":"md"}},"contact-form":{"type":"contact","settings":{"color_scheme":"","layout":"stacked","add_image_spacing":true,"subheading":"Kontakt os","title":"Vi vil meget gerne høre fra dig.","heading_size":"h2","content":"<p>Hvis du har spørgsmål, bedes du udfylde denne kontaktformular, så vender vores team tilbage til dig hurtigst muligt.<\/p>","show_social_media":true}},"text_with_icons_yYxyrT":{"type":"text-with-icons","blocks":{"item_NkXft6":{"type":"item","settings":{"icon":"picto-inbox","title":"E-mail","heading_tag":"h6","content":"<p>kontakt@galleriloura.dk<\/p>"}},"item_HWb7rh":{"type":"item","settings":{"icon":"picto-mobile-phone","title":"Telefon","heading_tag":"h6","content":"<p>Tlf: 27 63 76 10<\/p>"}},"item_Mbntfd":{"type":"item","settings":{"icon":"picto-location-pin","title":"Adresse","heading_tag":"h6","content":"<p>Thrigesvej 6, 18<br\/>8600 Silkeborg.<\/p>"}},"item_Cd8d8z":{"type":"item","settings":{"icon":"picto-store","title":"Åbningstider","heading_tag":"h6","content":"<p>Torsdag 10.00-15.00<br\/>Fredag 10.00-15.00<br\/>Lørdag (i lige uger) 10.00-13.00<\/p>"}}},"block_order":["item_NkXft6","item_HWb7rh","item_Mbntfd","item_Cd8d8z"],"name":"t:sections.text_with_icons.name","settings":{"color_scheme":"","subheading":"","title":"","content":"","heading_tag":"h3","text_alignment":"center","items_per_row_desktop":4,"stack_on_mobile":true,"separator_style":"vertical","icon_position":"inline","icon_width":36,"mobile_icon_width":32,"item_text_alignment":"center"}},"text_with_media_HKBtRa":{"type":"text-with-media","blocks":{"heading_QXyEcU":{"type":"heading","settings":{"text":"Kunstnerhenvendelser","heading_tag":"h2","position":"middle_left","highlight_effect":"default","highlight_accent_color":"","highlight_text_color":""}},"richtext_b3AEpL":{"type":"richtext","settings":{"text":"<p>Ønsker du at komme i betragtning til et samarbejde med galleriet, bedes <span style=\"text-decoration:underline\">alle<\/span> henvendelser sendes på mail. (kontakt@galleriloura.dk)<\/p><p>Vedhæft venligst mindst 2 billeder af værker samt en kort beskrivelse af dig selv, din arbejdsmetode og din motivation for at henvende dig til galleriet.<\/p><p>Da vi modtager mange henvendelser, kan der forekomme svartid.<\/p>","position":"middle_left"}}},"block_order":["heading_QXyEcU","richtext_b3AEpL"],"name":"t:sections.text_with_media.name","settings":{"color_scheme":"","content_position":"start","content_percentage_width":50,"overlay_color":"#000000","overlay_opacity":20,"add_media_spacing":true,"autoplay_video":true,"primary_image":"shopify:\/\/shop_images\/galleri_lou_ra_kontaktside.jpg","secondary_media_width":60,"secondary_media_mobile_width":60,"show_secondary_media_on_mobile":true,"secondary_media_alignment":"place-self-center","secondary_media_shape":"none"}}},"order":["main","contact-form","text_with_icons_yYxyrT","text_with_media_HKBtRa"]}